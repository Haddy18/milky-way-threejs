# Config para scripts/deploy.sh — copia a .env (gitignored) y rellena.
# En CI los mismos nombres vendrían de los secretos del repo.
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=
# Document root del sitio (http://<host>/milky-way/). Ruta absoluta; el
# script rechaza / y /var/www/html para no borrar nada por error.
VPS_DEPLOY_PATH=
# Comando de acceso al VPS. En local: el helper del escritorio, que guarda
# las credenciales (nunca se copian aquí ni al repo). Vacío = ssh estándar
# con clave (modo CI, que usa VPS_SSH_KEY abajo y fija el host key en
# .github/known_hosts). Si está definido, manda sobre VPS_HOST/USER/PUERTO.
# OJO: el valor va ENTRE COMILLAS si contiene espacios; sin ellas la línea
# se ejecuta como comando en vez de asignarse.
VPS_SSH=
# Modo CI (GitHub Actions, secretos del repo; no hace falta en local):
# clave ssh privada cuya parte pública está en authorized_keys del VPS.
# Por defecto, sin VPS_SSH_KEY se usa ~/.ssh/github-actions-deploy.
VPS_SSH_KEY=
# URL pública del sitio; el deploy la comprueba al terminar (200 en /, js/ y data/).
SITE_URL=
